# Names only — never commit real values.
# PUBLIC (browser-safe, needed at BUILD time; set as Cloudflare build variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# SERVER runtime (Worker variables; publishable key is not secret but stays server-side)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SERVER secret (wrangler secret put RESEND_API_KEY)
RESEND_API_KEY=
# Optional; defaults to "bestottr Support <support@bestottr.com>" — leave unset to keep current behavior
SUPPORT_EMAIL_FROM=

# Optional Roblox OAuth (Worker runtime only, never VITE_ secrets)
# Register callback: https://bestottr.com/api/roblox/callback
SITE_URL=https://bestottr.com
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_OAUTH_STATE_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Local development only. Production builds always disable sample trading.
VITE_DEMO_MODE=false

# Trustap test integration (Worker runtime only; never VITE_)
TRUSTAP_SANDBOX_ENABLED=false
TRUSTAP_CLIENT_ID=
TRUSTAP_SANDBOX_API_KEY=
TRUSTAP_SANDBOX_CLIENT_SECRET=
# Independent random secret, at least 32 characters
TRUSTAP_OAUTH_STATE_SECRET=
# Must match Basic Authentication configured in Trustap's sandbox webhook dashboard
TRUSTAP_WEBHOOK_USER=
TRUSTAP_WEBHOOK_PASSWORD=
# Independent random secret for the scheduled reconciliation endpoint
TRUSTAP_SYNC_SECRET=

# Server-only launch switch. Reviews/approvals work while false; no public catalog/media.
# Enabling later exposes a read-only catalog; it does not enable payments or auctions.
LISTING_PUBLICATION_ENABLED=false
