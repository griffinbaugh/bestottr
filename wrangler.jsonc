// Cloudflare Workers config for independently hosted BestOttr.
// `npm run build` emits the Worker to .output/server and static assets to .output/public.
// Deploy with: npm run cf:deploy   (uses this file explicitly, not an editor-managed deployment config)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bestottr",
  "keep_vars": true,
  // Cloudflare runs `wrangler preview` for PR branches; this block enables that command.
  "previews": {},
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  // Server bundle imports node:async_hooks / node:buffer / node:stream / node:process.
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "observability": { "enabled": true }
  // Secrets (RESEND_API_KEY etc.) are set with `wrangler secret put`, never committed here.
}
